<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Paghe.Core\Paghe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="PDFsharp" Version="6.2.1" />
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schemi XSD ufficiali FatturaPA (Agenzia delle Entrate) per la validazione. -->
    <EmbeddedResource Include="Schemi\Schema_VFPR12.xsd" />
    <EmbeddedResource Include="Schemi\xmldsig-core-schema.xsd" />
    <!-- Modello ufficiale AA7/10 (Agenzia delle Entrate 2025): compilato da Aa710PdfUfficiale. -->
    <EmbeddedResource Include="Modelli\AA7_10_modello_2025.pdf" />
    <!-- Modello ufficiale CU sintetico (Agenzia delle Entrate 2026): compilato da CuPdfUfficiale. -->
    <EmbeddedResource Include="Modelli\CU_sintetico_2026.pdf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
