<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Paghe.Core\Paghe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dataset ufficiale dei minimi CCNL (docs/dati, fonti CNEL): incorporato come risorsa
         e caricato all'avvio da CcnlDatasetUfficiale, sovrascrive i valori d'esempio del Seed. -->
    <EmbeddedResource Include="..\..\..\docs\dati\minimi-ccnl-*.json" Link="dati-ccnl\%(Filename)%(Extension)" />
    <!-- Voci variabili (orario, divisori, maggiorazioni): stesse fonti, stesso trattamento.
         Erano usate solo dai test, quindi in produzione ogni CCNL calcolava gli straordinari
         con le percentuali del Commercio. -->
    <EmbeddedResource Include="..\..\..\docs\dati\voci-variabili-ccnl-*.json" Link="dati-ccnl\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <!-- Il contesto resta indipendente dal provider: SQLite e Npgsql sono referenziati dall'host
         (Paghe.Api) e dai due progetti di migrazione, non da qui. -->
    <!-- Pin del runtime nativo SQLite a una versione non vulnerabile (NU1903 /
         GHSA-2m69-gcr7-jv3q): sovrascrive il lib.e_sqlite3 2.1.11 transitivo. Allineato ad Api/Tests. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
