# HTTPS automatico (Let's Encrypt) per il dominio indicato in .env (DOMINIO).
# Caddy rinnova i certificati da solo; serve solo che il DNS del dominio
# punti all'IP del VPS prima del primo avvio.

{$DOMINIO} {
    encode gzip

    # Pacchetti da installare sul PC: file messi in /opt/paghepro-scaricabili
    # sul server, scaricabili da https://DOMINIO/scarica/NOMEFILE
    handle_path /scarica/* {
        root * /scaricabili
        file_server browse
    }

    reverse_proxy app:8080
}
