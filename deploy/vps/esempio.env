# Copia questo file come .env nella stessa cartella sul VPS e completa i valori.
# Lo script scripts/pubblica-su-vps.sh lo fa da solo al primo avvio.

# Dominio (o sottodominio) che punta all'IP del VPS. Esempio: paghe.tuodominio.it
DOMINIO=

# Firma i token di accesso. Genera con: openssl rand -base64 48
Jwt__Key=

# Cifra IBAN e dati sensibili nel database. Genera con: openssl rand -base64 32
# ATTENZIONE: se questa chiave si perde, i dati cifrati non si recuperano più.
# Conservane una copia fuori dal server.
PAGHE_DATA_KEY=

# Aurora (stessa configurazione di Render): DeepSeek principale, Gemini riserva.
# Per spegnere l'AI: Ai__Provider=Spento
Ai__Provider=DeepSeek
Ai__ApiKey=
Ai__UsaGeminiComeFallback=true
Ai__GeminiApiKey=
Ai__ModelloGemini=gemini-3.5-flash
Ai__SoloLocale=false
Ai__ProviderCloudApprovato=true
Ai__GateLocaleG1Verificato=false
Ai__GateAurora=A2
Ai__ModalitaA3=Off
